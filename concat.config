# concat.config
# Configuration file for the file concatenator script (c.sh)

# Directories to exclude from concatenation
EXCLUDE_DIRS=(
  ".git"
  ".vercel"
  "node_modules"
)

# Specific file names or substrings to exclude
EXCLUDE_FILES=(
  "package-lock.json"
  "pnpm-lock.yaml"
  "yarn.lock"
  "current_response.json"
  "project_concat.txt"
)

# Allowed file extensions to scan and include
ALLOWED_EXTENSIONS=(
  ".md"
  ".sh"
  ".config"
  ".py"
)
# concat.config.quiz-builder — AI Quiz Builder for Policies & Procedures (Expanded)
#
# Aggregates a wider, more contextual set of files for the "Quiz Builder" feature.
# This provides a more holistic view of related application areas.
#
# Usage: copy this content into your concat.config and run the concat script:
#   ./concat.sh

# Output filename
OUTPUT_FILE="a.txt"

# ==========================================
# EXCLUDES (Standard project exclusions)
# ==========================================
EXCLUDES=(
    "*.ico" "*.lock" "*.png" "*.jpg" "*.jpeg" "*.gif" "*.svg"
    "package-lock.json" "pnpm-lock.yaml" "yarn.lock"
    "./app/test/*" "./stories/assets/*" "./stories/Configure.mdx/*"
)

# ==========================================
# PRUNES (Standard project exclusions)
# ==========================================
PRUNES=(
    "./node_modules" "./.next" "./.venv" "./dist" "./.git" "./.husky"
    "./.vscode" "./public/tinymce" "./coverage" "./playwright-report"
    "./infra/cdk.out" "./infra/node_modules" "./.opencode"
)

# ==========================================
# INCLUDES (TARGETED FOR QUIZ BUILDER FEATURE)
# ==========================================
INCLUDE_PATHS=(
    # --- Core AI and Schema Definitions ---
    "./lib/ai/agents/article-parser.agent.ts"
    "./mastra.config.ts"

    "./apply_changes.py"
    "./bridge.sh"

    # --- Core Types (Essential for Data Models) ---
    "./types/ENUMS.ts"
    "./types/shared/AuthUser.ts"
    "./app/(dashboard)/(company)/policies-and-procedures/all-articles/types.ts"
    "./app/(dashboard)/admin/policies-and-procedures/master-articles/types.ts"
    "./app/(dashboard)/admin/manage-forms/all-forms/types.ts"
    "./types/company/public/LocalDigitalForm.ts"
    "./types/admin/public/MasterDigitalForm.ts"
    "./types/admin/public/Company.ts"
    "./types/company/public/Site.ts"

    # --- SurveyJS Core Integration (The Output) ---
    "./components/forms/DynamicSurveyCreator.tsx"
    "./components/forms/SurveyCreator.tsx"
    "./components/forms/useSurveyCreator.tsx"
    "./components/forms/DynamicSurveyRunner.tsx"
    "./components/forms/SurveyRunner.tsx"
    "./components/forms/form-conversion-utils.ts"
    "./app/api/surveyjs/users/route.ts"
    "./app/api/surveyjs/sites/route.ts"
    "./actions/forms/master-forms/create-master-form-action.ts"
    "./actions/forms/master-forms/create-master-form.effect.ts"

    # --- Full "Manage Forms" Lifecycle (Where the quiz will live) ---
    "./app/(dashboard)/admin/manage-forms/*"
    "./actions/forms/master-forms/*"
    "./actions/forms/local-forms/*"

    # --- Policies & Procedures (The Input Data) ---
    # Key actions for fetching and understanding article structure
    "./actions/policies-and-procedures/fetch-master-articles-action.ts"
    "./actions/policies-and-procedures/fetch-articles-action.ts"
    "./actions/policies-and-procedures/fetch-local-article-by-id-action.ts"
    "./actions/policies-and-procedures/fetch-master-article-by-id-action.ts"
    # The full article form logic provides deep context on the data model
    "./app/(dashboard)/(company)/policies-and-procedures/hooks/useArticleForm.ts"
    "./app/(dashboard)/admin/policies-and-procedures/master-articles/hooks/useMasterArticleForm.ts"
    "./components/policies-and-procedures/UnifiedArticleForm.tsx"
    # The view where the user will see the article content
    "./components/policies-and-procedures/ArticleContentView.tsx"
    # Admin and Company article listing pages (potential entry points for the feature)
    "./app/(dashboard)/admin/policies-and-procedures/master-articles/MasterArticlesTableClient.tsx"
    "./app/(dashboard)/(company)/policies-and-procedures/all-articles/ClientArticlesPage.tsx"


    # --- Core Application Structure & Context ---
    "./app/(dashboard)/layout.tsx"
    "./components/sidebar/LayoutWithSidebar.tsx"
    "./components/sidebar/useSidebar.tsx"
    "./components/sidebar/Menu.tsx"
    "./contexts/AuthProvider.tsx"
    "./contexts/LoadingProvider.tsx"
    "./contexts/PoliciesViewProvider.tsx"

    # --- Core Server Libraries & Middleware ---
    "./lib/server/safe-action.ts"
    "./lib/server/kysely.ts"
    "./lib/server/getCompanyDb.ts"
    "./lib/server/verifyPermissions.ts"
    "./lib/server/logger.server.ts"
    "./lib/utils.ts"
    "./actions/middleware/company-and-permissions-middleware.ts"
    "./actions/middleware/logging-middleware.ts"
    "./actions/shared/fetch-user-sites-action.ts"
    "./actions/policies-and-procedures/fetch-company-admins-action.ts"

    # --- Essential UI Components ---
    "./components/custom-ui/custom-button.tsx"
    "./components/custom-ui/custom-dialog-two-buttons.tsx"
    "./components/custom-ui/custom-card-expanding.tsx"
    "./components/custom-ui/custom-content-header.tsx"
    "./components/custom-ui/custom-input.tsx"
    "./components/custom-ui/custom-combobox.tsx"
    "./components/custom-ui/custom-multiselect-collapsible.tsx"
    "./components/sidebar/fixed-page-toolbar.tsx"
    "./components/PageInfoBanner.tsx"

    # --- Relevant Root-Level Files ---
    "FLAT:./"
)

# ==========================================
# ROOT LEVEL SCAN CONFIG
# ==========================================
ROOT_EXTENSIONS=("*.js" "*.ts" "*.json" "*.md")
ROOT_EXCLUDES=("*package-lock.json" "*pnpm-lock.yaml" "*tsconfig.tsbuildinfo")
