# concat.config
# Configuration file for the file concatenator script (c.sh)

# Default output file name
OUTPUT_FILE="a.txt"

# Directories to prune/exclude from entering
PRUNES=(
  ".git"
  "node_modules"
  ".vercel"
  "content/assets"
)

# Specific files to exclude from concatenation
EXCLUDES=(
  "./package-lock.json"
  "./pnpm-lock.yaml"
  "./current_response.json"
  "./flake.lock"
)

# Allowed file extensions to scan recursively
ALLOWED_EXTENSIONS=(
  ".md"
  ".sh"
  ".config"
  ".py"
  ".nix"
)
